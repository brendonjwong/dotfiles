# Local/private config goes in the include
[include]
    path = ./.gitconfig-local
[alias]
    promote = !$ZSH/bin/git-promote
    wtf     = !$ZSH/bin/git-wtf
    co = checkout
    br = branch
    ci = commit
    d = diff
    ds = diff --staged
    l = log
    rb = rebase
    pu = pull -p
    wdid = log --author "brendonjwong" --all --since "yesterday"
    wt = worktree
[color]
    diff = auto
    status = auto
    branch = auto
    ui = true
[core]
    editor = /opt/homebrew/bin/nvim
    excludesfile = /Users/brendon/.gitignore
# [merge]
#     conflictstyle = diff3
[mergetool]
    keepBackup = false
[diff]
    tool = vimdiff
[pull]
    rebase = true
[push]
    default = current
[rebase]
    autostash = true
[init]
    defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
